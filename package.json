{
	"name": "indigo",
	"version": "0.3.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"tauri": "tauri",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"bindings": "cargo test -p indigo-core --lib export_bindings"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2.12.4",
		"@types/diff": "^7.0.2",
		"@types/node": "^26",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^31.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"@lucide/svelte": "^1.72.0",
		"@replit/codemirror-vim": "^6.4.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"codemirror": "^6.0.2",
		"daisyui": "^5.7.50",
		"diff": "^9.0.0",
		"dompurify": "^3.4.17",
		"marked": "^18.2.0",
		"shiki": "^4.6.0",
		"svelte-dnd-action": "^0.9.80"
	}
}
